// Hosting on Cloudflare (Workers static assets), so the repo can be private on GitHub's free plan.
// Cloudflare builds from main: build command `npm run build`, deploy command `npx wrangler deploy`.
{
  "name": "abuosba",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "force-trailing-slash"
  }
}
