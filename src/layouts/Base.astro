---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import Intro from "../components/Intro.astro";

interface Props {
  title?: string;
  description?: string;
  intro?: boolean;
}
const { title, description = "Suhail AbuOsba builds systems and dashboards for higher education. Notes, work and the sky over Sana'a.", intro = false } = Astro.props;
const fullTitle = title ? `${title} · Suhail` : "Suhail AbuOsba";
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#161b44" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <script is:inline define:vars={{ intro }}>
      // Scripts are on, so motion may hide things until they arrive. The landing plays once, on a first visit.
      var h = document.documentElement;
      h.classList.add("js");
      try {
        if (intro && !localStorage.getItem("seen-landing") && !matchMedia("(prefers-reduced-motion: reduce)").matches && !location.hash) h.classList.add("intro-on");
      } catch (e) {}
    </script>
  </head>
  <body>
    {intro && <Intro />}
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <script>
      // Reveal things as they scroll into view; staged pieces (Sunrise, Glazed) run once they are well in.
      const reveal = document.querySelectorAll<HTMLElement>("[data-reveal]");
      const staged = document.querySelectorAll<HTMLElement>("[data-mo]");
      const show = (el: HTMLElement) => el.classList.add(el.hasAttribute("data-mo") ? "run" : "in");
      if ("IntersectionObserver" in window) {
        const io = new IntersectionObserver((es) => es.forEach((e) => {
          if (e.isIntersecting) { show(e.target as HTMLElement); io.unobserve(e.target); }
        }), { threshold: 0.2, rootMargin: "0px 0px -6% 0px" });
        reveal.forEach((el) => io.observe(el));
        staged.forEach((el) => io.observe(el));
      } else {
        reveal.forEach(show);
        staged.forEach(show);
      }
    </script>
  </body>
</html>
