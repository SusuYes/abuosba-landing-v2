---
---
<footer class="ft">
  <div class="in">
    <a class="sig" href="/" aria-label="Home">
      <img src="/brand/wordmark-brass.svg" alt="سُهَيْل" width="63" height="40" />
    </a>
    <span class="live">Sana'a <b data-sanaa-time>--:--</b><span class="dot">·</span>Suhail <b data-suhail-alt>--°</b></span>
    <span class="c">© 2026 Suhail AbuOsba</span>
  </div>
</footer>

<script>
  // Sana'a time, and how high Suhail stands over its horizon right now.
  const time = document.querySelector<HTMLElement>("[data-sanaa-time]");
  const alt = document.querySelector<HTMLElement>("[data-suhail-alt]");
  const fmt = new Intl.DateTimeFormat("en-GB", { timeZone: "Asia/Aden", hour: "2-digit", minute: "2-digit" });
  const R = Math.PI / 180;
  const suhailAlt = (d: Date) => {
    const n = d.getTime() / 86400000 + 2440587.5 - 2451545.0;
    const H = (280.46061837 + 360.98564736629 * n + 44.19 - 95.988) * R, lat = 15.37 * R, dec = -52.696 * R;
    return Math.asin(Math.sin(lat) * Math.sin(dec) + Math.cos(lat) * Math.cos(dec) * Math.cos(H)) / R;
  };
  const tick = () => {
    const d = new Date(), a = suhailAlt(d);
    if (time) time.textContent = fmt.format(d);
    if (alt) alt.textContent = (a < 0 ? "−" : "+") + Math.abs(a).toFixed(0) + "°" + (a > -0.57 ? " · up" : "");
  };
  tick();
  setInterval(tick, 15000);
</script>

<style>
  .ft { border-top: 1px solid var(--r); margin-top: auto; }
  .in {
    display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px;
    padding: 28px var(--gutter); max-width: var(--wrap); margin-inline: auto;
    font-size: 14px; color: var(--m); font-variant-numeric: tabular-nums lining-nums;
  }
  .sig { line-height: 0; justify-self: start; transition: transform 0.3s var(--ease); }
  .sig:hover { transform: translateY(-2px); }
  .sig img { width: 63px; height: 40px; }
  .live { justify-self: center; }
  .c { justify-self: end; }
  .dot { margin-inline: 10px; opacity: 0.5; }
  b { color: var(--a); font-weight: 400; }
  @media (max-width: 760px) {
    .in { grid-template-columns: 1fr; justify-items: center; text-align: center; gap: 10px; }
    .sig, .live, .c { justify-self: center; }
  }
</style>
