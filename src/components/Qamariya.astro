---
// The coloured-glass arch of the tower houses, once per page over its opening. It lights up with Sunrise.
import arch from "../assets/qamariya-arch.svg?raw";
interface Props { size?: number }
const { size = 420 } = Astro.props;
---
<div class="arch sunrise" data-mo style={`--w:${size}px`} set:html={arch} />

<style>
  .arch :global(svg) { width: min(100%, var(--w)); height: auto; display: block; margin-inline: auto; filter: drop-shadow(rgba(240, 185, 58, 0.35) 0 0 10px); }
</style>
