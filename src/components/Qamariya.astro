---
// The coloured-glass arch of the tower houses, once per page over its opening.
import arch from "../assets/qamariya-arch.svg?raw";
---
<div class="arch" set:html={arch} />

<style>
  .arch { margin: -6px 0 12px; }
  .arch :global(svg) { width: min(100%, 420px); height: auto; display: block; filter: drop-shadow(rgba(240, 185, 58, 0.35) 0 0 10px); }
</style>
