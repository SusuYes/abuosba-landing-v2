---
import Base from "../layouts/Base.astro";
import Qamariya from "../components/Qamariya.astro";
---
<Base title="Not found">
  <div class="page single">
    <article>
      <Qamariya />
      <div class="lb">404</div>
      <h1 class="display">Nothing under this star</h1>
      <p class="lede">This page doesn't exist, or it has moved. <a href="/">Back to the start</a>.</p>
    </article>
  </div>
</Base>
